# Virello Studio web app. Everything here is PUBLIC (shipped to browsers).
# Never put secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth (anon key is public by design; data is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# supabase | local — defaults to supabase when the two values above are set
NEXT_PUBLIC_AUTH_MODE=
# Show "Continue with Google" (enable the Google provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Origins of your object storage, comma separated, for the Content Security Policy
# e.g. https://<account>.r2.cloudflarestorage.com
NEXT_PUBLIC_STORAGE_ORIGINS=

NEXT_PUBLIC_SUPPORT_EMAIL=
