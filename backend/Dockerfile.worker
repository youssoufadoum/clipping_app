# Virello Studio processing worker (Celery + FFmpeg).
# Built from the same base as the API so code and dependencies always match.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.8.17

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app ./app

RUN useradd --create-home --uid 10001 virello && mkdir -p /app/var && chown -R virello /app/var
USER virello
ENV PATH="/app/.venv/bin:$PATH"

# Concurrency is bounded by MAX_RENDER_CONCURRENCY; each task is also time-limited.
CMD ["sh", "-c", "celery -A app.worker.celery_app worker -Q media --concurrency ${MAX_RENDER_CONCURRENCY:-2} --max-tasks-per-child 50 --loglevel INFO"]
