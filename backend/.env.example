# ---------------------------------------------------------------------------
# Virello Studio backend configuration. Copy to .env and fill in.
# Placeholders only — never commit real secrets.
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
# 32+ random characters. Signs local-storage URLs and dev tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://virello:virello@localhost:5432/virello
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---------------------------------------------------------
# supabase (production) | local (development only; refused when APP_ENV=production)
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Used to delete auth users on account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json (asymmetric signing keys)
SUPABASE_JWT_JWKS_URL=
# Only for legacy projects that still sign access tokens with HS256
SUPABASE_JWT_SECRET=
# Comma-separated emails granted administrator access
ADMIN_EMAILS=

# --- Storage --------------------------------------------------------------
# s3 (production; Amazon S3, Cloudflare R2, MinIO) | local (single machine only)
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=./var/storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# --- URLs -----------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# Optional comma-separated list; defaults to FRONTEND_URL
CORS_ORIGINS=

# --- Limits (plan limits apply on top of these global caps) ---------------
MAX_UPLOAD_BYTES=5368709120
MAX_VIDEO_DURATION_SECONDS=14400
MAX_RENDER_CONCURRENCY=2
FFMPEG_TIMEOUT_SECONDS=3600
WORK_DIR=./var/work
# Reserved: automatic media expiry is not enforced yet (see README roadmap)
MEDIA_RETENTION_DAYS=30

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
# Bearer token required by GET /metrics (disabled when empty)
METRICS_TOKEN=

# --- Later phases (not used by phase 1 code paths) ------------------------
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_ANALYSIS_MODEL=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
