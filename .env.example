# Copy this file to `.env` (same folder as docker-compose.yml) and fill in what you have.
# Never commit the real .env — it is git-ignored.

# --- Real accounts with email verification codes (Supabase) ------------------
# Leave AUTH_MODE=local to use the dev-only sign-in (no emails, any address).
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only; used to delete accounts. Never put it in frontend variables.
SUPABASE_SERVICE_ROLE_KEY=
# Only for older Supabase projects that sign tokens with a shared JWT secret
SUPABASE_JWT_SECRET=

# --- AI shorts (Google Gemini) ------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
